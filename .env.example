# Postgres (consumed by docker-compose and the backend)
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=finance
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+asyncpg://finance:change-me-locally@localhost:5432/finance
JWT_SECRET=generate-with-openssl-rand-hex-32
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173

# Seed users (M1) - never commit real values
SEED_HOUSEHOLD_NAME=Household
SEED_USER_1_EMAIL=user1@example.com
SEED_USER_1_PASSWORD=change-me
SEED_USER_2_EMAIL=user2@example.com
SEED_USER_2_PASSWORD=change-me
